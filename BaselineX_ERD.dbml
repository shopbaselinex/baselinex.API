// BaselineX ERD v2
// Target: Azure Database for PostgreSQL + EF Core (Npgsql)
//
// IMPLEMENTATION RULES (for the coding agent):
// - Auth is Supabase Auth (separate hosted service, separate DB). No auth.users table here.
//   user_profiles.id = Supabase JWT "sub" claim. No FK to Supabase. Profile is upserted on first API call.
// - Enums below are stored as varchar(30) via EF Core HasConversion<string>(), NOT native Postgres enums.
// - Optimistic concurrency uses Postgres xmin (EF: uint Version + IsRowVersion()). No manual version columns.
// - updated_at is set in DbContext.SaveChanges override, not by DB default.
// - All money = decimal(12,2). All timestamps = timestamptz, stored UTC.
// - Image/file bytes live in Cloudflare R2; DB stores object keys + metadata only.
// - Product = canonical catalog item. Listing = specific item for sale.
// - Status fields change only via explicit domain methods, never set directly by the client.

Project BaselineX {
  database_type: 'PostgreSQL'
  Note: 'BaselineX racquet sports marketplace and Play platform'
}

// -----------------------------------------------------------------------------
// ENUMS (stored as varchar)
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// ENUMS (stored as varchar)
// -----------------------------------------------------------------------------

Enum listing_condition {
  new
  like_new
  excellent
  good
  fair
}

Enum listing_status {
  draft
  active
  reserved
  sold
  removed
}

Enum organization_type {
  tennis_club
  pickleball_club
  pro_shop
  academy
}

Enum organization_role {
  owner
  administrator
  coach
  staff
}

Enum offer_status {
  pending
  accepted
  declined
  countered
  expired
  withdrawn
}

Enum order_status {
  pending_payment
  paid
  awaiting_shipment
  shipped
  delivered
  completed
  cancelled
  refunded
}

Enum payment_status {
  pending
  requires_action
  succeeded
  failed
  cancelled
  partially_refunded
  refunded
}

Enum shipment_status {
  pending
  label_created
  shipped
  in_transit
  delivered
  returned
  cancelled
}

Enum activity_type {
  private_lesson
  semi_private_lesson
  group_clinic
  live_ball
  cardio_tennis
  beginner_class
  intermediate_clinic
  advanced_clinic
  junior_clinic
  pickleball_lesson
  pickleball_open_play
  padel_lesson
  squash_lesson
  hitting_session
  camp
  social_event
}

Enum session_status {
  scheduled
  cancelled
  completed
}

Enum booking_status {
  pending_payment
  confirmed
  cancelled
  refunded
  completed
  no_show
}

Enum review_subject_type {
  seller
  coach
  organization
  activity
}

Enum seller_inventory_type {
  self_service
  managed_resale
  baselinex_owned
}

Enum price_unit {
  per_person
  per_session
  per_hour
  flat
}

Enum stripe_event_status {
  received
  processed
  ignored
  failed
}

Enum stripe_onboarding_status {
  not_started
  pending
  complete
  restricted
}
// -----------------------------------------------------------------------------
// IDENTITY
// -----------------------------------------------------------------------------

Table user_profiles {
  id uuid [pk, note: '= Supabase JWT sub. Not generated by DB.']
  display_name varchar(120) [not null]
  first_name varchar(100)
  last_name varchar(100)
  avatar_object_key varchar(500)
  bio text
  city varchar(120)
  state varchar(80)
  neighborhood varchar(120)
  stripe_account_id varchar(255) [note: 'Stripe Connect account for payouts']
  stripe_onboarding_status stripe_onboarding_status [not null, default: 'not_started']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (city, state)
    stripe_account_id [unique]
  }

  Note: 'Passwords never stored here. Email lives in Supabase.'
}

// -----------------------------------------------------------------------------
// CATALOG
// -----------------------------------------------------------------------------

Table sports {
  id int [pk, increment]
  name varchar(80) [not null]
  slug varchar(80) [not null, unique]
  is_active boolean [not null, default: true]
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
}

Table brands {
  id int [pk, increment]
  name varchar(120) [not null]
  slug varchar(120) [not null, unique]
  logo_object_key varchar(500)
  is_active boolean [not null, default: true]
}

Table products {
  id uuid [pk]
  sport_id int [not null]
  category_id int [not null]
  brand_id int [not null]
  name varchar(180) [not null]
  model varchar(180)
  model_year int
  retail_price decimal(12,2)
  currency char(3) [not null, default: 'USD']
  description text
  primary_image_object_key varchar(500)
  specifications jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (brand_id, name)
    (sport_id, category_id, brand_id)
  }

  Note: 'Canonical catalog product. One product, many listings.'
}

// -----------------------------------------------------------------------------
// ORGANIZATIONS
// -----------------------------------------------------------------------------

Table organizations {
  id uuid [pk]
  name varchar(180) [not null]
  slug varchar(180) [not null, unique]
  type organization_type [not null]
  description text
  logo_object_key varchar(500)
  cover_object_key varchar(500)
  city varchar(120)
  state varchar(80)
  neighborhood varchar(120)
  website varchar(500)
  phone varchar(40)
  is_verified boolean [not null, default: false]
  stripe_account_id varchar(255) [note: 'Stripe Connect account for club payouts']
  stripe_onboarding_status stripe_onboarding_status [not null, default: 'not_started']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    type
    (city, state)
    is_verified
    stripe_account_id [unique]
  }
}

Table organization_members {
  id uuid [pk]
  organization_id uuid [not null]
  user_id uuid [not null]
  role organization_role [not null]
  created_at timestamptz [not null]

  indexes {
    (organization_id, user_id) [unique]
    user_id
  }
}

Table coach_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  bio text
  years_experience int
  private_lesson_rate decimal(12,2)
  currency char(3) [not null, default: 'USD']
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Coach payouts use user_profiles.stripe_account_id.'
}

Table coach_sports {
  coach_profile_id uuid [not null]
  sport_id int [not null]

  indexes {
    (coach_profile_id, sport_id) [pk]
  }
}

// -----------------------------------------------------------------------------
// MARKETPLACE
// -----------------------------------------------------------------------------

Table listings {
  id uuid [pk]
  seller_user_id uuid [not null]
  organization_id uuid
  product_id uuid [note: 'Null = custom/manual listing']
  sport_id int [not null]
  category_id int [not null]
  brand_id int [not null]

  title varchar(180) [not null]
  description text [not null]
  price decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']

  condition listing_condition [not null]
  status listing_status [not null, default: 'draft']

  shipping_available boolean [not null, default: false]
  local_pickup_available boolean [not null, default: false]
  pickup_city varchar(120)
  pickup_neighborhood varchar(120)

  is_demo boolean [not null, default: false]
  accepts_offers boolean [not null, default: true]
  inventory_type seller_inventory_type [not null, default: 'self_service']
  item_specifications jsonb

  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  published_at timestamptz
  sold_at timestamptz

  indexes {
    product_id
    organization_id
    price
    (status, created_at)
    (sport_id, category_id, status)
    (brand_id, status)
    (seller_user_id, status)
    (organization_id, status)
    (local_pickup_available, pickup_city)
  }

  Note: '''
  Concurrency via xmin. Transitions: Publish (draft->active), Reserve (active->reserved),
  MarkSold (active|reserved->sold), Remove (any except sold->removed).
  If product_id is set, sport/category/brand must match the product (enforce in handler).
  '''
}

Table listing_images {
  id uuid [pk]
  listing_id uuid [not null]
  object_key varchar(500) [not null, unique]
  content_type varchar(120) [not null]
  size_bytes bigint
  width int
  height int
  sort_order int [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null]

  indexes {
    (listing_id, sort_order)
  }

  Note: 'Bytes in R2. Upload via presigned URL directly from client.'
}

Table favorites {
  user_id uuid [not null]
  listing_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, listing_id) [pk]
    listing_id
  }
}

Table offers {
  id uuid [pk]
  listing_id uuid [not null]
  buyer_id uuid [not null]
  seller_id uuid [not null]
  amount decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  status offer_status [not null, default: 'pending']
  parent_offer_id uuid [note: 'Set on counter-offers']
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    buyer_id
    seller_id
    expires_at
    (listing_id, status)
  }

  Note: 'Only listing owner can accept. Expired offers cannot be accepted. Buyer != seller.'
}

// -----------------------------------------------------------------------------
// COMMERCE
// -----------------------------------------------------------------------------

Table orders {
  id uuid [pk]
  order_number varchar(60) [not null, unique]
  buyer_id uuid [not null]
  seller_id uuid [not null]
  organization_id uuid
  status order_status [not null, default: 'pending_payment']

  subtotal decimal(12,2) [not null]
  shipping_amount decimal(12,2) [not null, default: 0]
  platform_fee decimal(12,2) [not null, default: 0]
  tax_amount decimal(12,2) [not null, default: 0]
  total decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']

  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  paid_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz

  indexes {
    organization_id
    status
    (buyer_id, created_at)
    (seller_id, created_at)
  }

  Note: 'One order per seller. Prices always computed from DB, never from client input.'
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null]
  listing_id uuid [not null]
  title_snapshot varchar(250) [not null]
  price_snapshot decimal(12,2) [not null]
  quantity int [not null, default: 1]
  created_at timestamptz [not null]

  indexes {
    order_id
    listing_id
  }

  Note: 'Immutable snapshots.'
}

Table payments {
  id uuid [pk]
  order_id uuid [not null]
  provider varchar(50) [not null, default: 'stripe']
  provider_payment_intent_id varchar(255) [unique]
  provider_charge_id varchar(255)
  amount decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  status payment_status [not null, default: 'pending']
  stripe_connected_account_id varchar(255)
  transfer_id varchar(255)
  refund_id varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    order_id
    provider_charge_id
    status
  }

  Note: 'No payout_id: Stripe payouts are batched per account, not per payment.'
}

Table shipments {
  id uuid [pk]
  order_id uuid [not null]
  carrier varchar(80)
  service_level varchar(120)
  tracking_number varchar(180)
  label_url varchar(1000)
  status shipment_status [not null, default: 'pending']
  recipient_name varchar(180)
  address_line1 varchar(180)
  address_line2 varchar(180)
  city varchar(120)
  state varchar(80)
  postal_code varchar(30)
  country_code char(2)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  shipped_at timestamptz
  delivered_at timestamptz

  indexes {
    order_id
    tracking_number
    status
  }
}

Table stripe_webhook_events {
  id uuid [pk]
  stripe_event_id varchar(255) [not null, unique]
  event_type varchar(180) [not null]
  status stripe_event_status [not null, default: 'received']
  payload_hash varchar(128)
  received_at timestamptz [not null]
  processed_at timestamptz
  error_message text

  indexes {
    status
    received_at
  }

  Note: 'Idempotency: insert first; unique violation on stripe_event_id = already handled, return 200.'
}

// -----------------------------------------------------------------------------
// PLAY
// -----------------------------------------------------------------------------

Table activities {
  id uuid [pk]
  host_user_id uuid
  organization_id uuid
  sport_id int [not null]
  type activity_type [not null]
  title varchar(220) [not null]
  description text [not null]
  skill_level varchar(100)
  age_group varchar(100)
  price decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  price_unit price_unit [not null, default: 'per_person']
  default_capacity int
  equipment_requirements text
  cancellation_policy text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    host_user_id
    organization_id
    (sport_id, type, is_active)
  }

  Note: 'At least one of host_user_id / organization_id must be set (check constraint).'
}

Table activity_sessions {
  id uuid [pk]
  activity_id uuid [not null]
  start_time_utc timestamptz [not null]
  end_time_utc timestamptz [not null]
  capacity int [not null]
  booked_count int [not null, default: 0]
  venue_name varchar(180)
  area varchar(160)
  address_private text
  status session_status [not null, default: 'scheduled']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (activity_id, start_time_utc)
    (status, start_time_utc)
  }

  Note: '''
  Check constraints: booked_count >= 0, booked_count <= capacity, end_time_utc > start_time_utc.
  Book atomically: UPDATE activity_sessions SET booked_count = booked_count + @n
  WHERE id = @id AND status = 'scheduled' AND booked_count + @n <= capacity.
  0 rows affected = full. Decrement on cancel/refund in the same transaction.
  '''
}

Table bookings {
  id uuid [pk]
  activity_session_id uuid [not null]
  user_id uuid [not null]
  participant_count int [not null, default: 1]
  subtotal decimal(12,2) [not null]
  platform_fee decimal(12,2) [not null, default: 0]
  tax_amount decimal(12,2) [not null, default: 0]
  total decimal(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  status booking_status [not null, default: 'pending_payment']
  provider_payment_intent_id varchar(255) [unique]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  cancelled_at timestamptz

  indexes {
    (activity_session_id, status)
    (user_id, created_at)
  }
}

// -----------------------------------------------------------------------------
// MESSAGING
// -----------------------------------------------------------------------------

Table conversations {
  id uuid [pk]
  listing_id uuid
  activity_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    listing_id
    activity_id
    updated_at
  }
}

Table conversation_participants {
  conversation_id uuid [not null]
  user_id uuid [not null]
  joined_at timestamptz [not null]
  last_read_at timestamptz [note: 'Unread = messages.created_at > last_read_at']

  indexes {
    (conversation_id, user_id) [pk]
    user_id
  }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null]

  indexes {
    (conversation_id, created_at)
    sender_id
  }
}

// -----------------------------------------------------------------------------
// REVIEWS
// -----------------------------------------------------------------------------

Table reviews {
  id uuid [pk]
  reviewer_id uuid [not null]
  subject_type review_subject_type [not null]
  subject_id uuid [not null]
  rating int [not null]
  comment text
  created_at timestamptz [not null]

  indexes {
    (reviewer_id, subject_type, subject_id) [unique]
    (subject_type, subject_id)
    created_at
  }

  Note: '''
  Check constraint: rating BETWEEN 1 AND 5.
  Polymorphic subject_id has no FK; validate existence in handler.
  Only allow reviews after a completed order/booking with the subject.
  '''
}

// -----------------------------------------------------------------------------
// RELATIONSHIPS
// -----------------------------------------------------------------------------

Ref: products.sport_id > sports.id
Ref: products.category_id > categories.id
Ref: products.brand_id > brands.id

Ref: organization_members.organization_id > organizations.id
Ref: organization_members.user_id > user_profiles.id

Ref: coach_profiles.user_id - user_profiles.id
Ref: coach_sports.coach_profile_id > coach_profiles.id
Ref: coach_sports.sport_id > sports.id

Ref: listings.seller_user_id > user_profiles.id
Ref: listings.organization_id > organizations.id
Ref: listings.product_id > products.id
Ref: listings.sport_id > sports.id
Ref: listings.category_id > categories.id
Ref: listings.brand_id > brands.id

Ref: listing_images.listing_id > listings.id [delete: cascade]

Ref: favorites.user_id > user_profiles.id [delete: cascade]
Ref: favorites.listing_id > listings.id [delete: cascade]

Ref: offers.listing_id > listings.id
Ref: offers.buyer_id > user_profiles.id
Ref: offers.seller_id > user_profiles.id
Ref: offers.parent_offer_id > offers.id

Ref: orders.buyer_id > user_profiles.id
Ref: orders.seller_id > user_profiles.id
Ref: orders.organization_id > organizations.id

Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.listing_id > listings.id

Ref: payments.order_id > orders.id
Ref: shipments.order_id > orders.id

Ref: activities.host_user_id > user_profiles.id
Ref: activities.organization_id > organizations.id
Ref: activities.sport_id > sports.id

Ref: activity_sessions.activity_id > activities.id

Ref: bookings.activity_session_id > activity_sessions.id
Ref: bookings.user_id > user_profiles.id

Ref: conversations.listing_id > listings.id
Ref: conversations.activity_id > activities.id

Ref: conversation_participants.conversation_id > conversations.id [delete: cascade]
Ref: conversation_participants.user_id > user_profiles.id

Ref: messages.conversation_id > conversations.id [delete: cascade]
Ref: messages.sender_id > user_profiles.id

Ref: reviews.reviewer_id > user_profiles.id